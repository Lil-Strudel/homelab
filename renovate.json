{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:enableMajor"],
  "timezone": "America/Denver",
  "schedule": ["before 9am on monday"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "flux": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kubernetes/infrastructure/controllers/kube-vip/kube-vip\\.yaml$/",
        "/docs/src/notes/creating-kube-vip-manifest\\.md$/",
        "/docs/src/architecture\\.md$/"
      ],
      "matchStrings": [
        "image:\\s*ghcr\\.io/kube-vip/kube-vip:(?<currentValue>v[0-9.]+)",
        "app\\.kubernetes\\.io/version:\\s*(?<currentValue>v[0-9.]+)",
        "kube-vip:(?<currentValue>v[0-9.]+)",
        "\\*\\*kube-vip\\*\\* \\((?<currentValue>v[0-9.]+)\\)"
      ],
      "depNameTemplate": "ghcr.io/kube-vip/kube-vip",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/docs/src/notes/talos-setup\\.md$/",
        "/docs/src/architecture\\.md$/"
      ],
      "matchStrings": [
        "--version (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)",
        "\\*\\*Cilium\\*\\* \\((?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\)"
      ],
      "depNameTemplate": "cilium",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io/",
      "versioningTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/docs/src/notes/talos-setup\\.md$/"],
      "matchStrings": ["--version=(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/talos/patch\\.yaml$/",
        "/docs/src/notes/talos-setup\\.md$/"
      ],
      "matchStrings": [
        "metal-installer-secureboot/[a-f0-9]+:(?<currentValue>v[0-9.]+)",
        "Talos (?<currentValue>v[0-9.]+)",
        "at tag `(?<currentValue>v[0-9.]+)`"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchPackageNames": ["rook-ceph", "rook-ceph-cluster"],
      "groupName": "rook-ceph"
    },
    {
      "matchPackageNames": ["cilium"],
      "groupName": "cilium"
    },
    {
      "matchManagers": ["flux", "custom.regex"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["terraform"],
      "rangeStrategy": "bump"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  }
}
